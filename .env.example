# Application
APP_NAME="Developer Landing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_HTTP_PORT=8000
FRONTEND_URL=http://localhost:8000
TRUSTED_PROXIES=127.0.0.1,::1

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Runtime
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=test-dev-landing
DB_USERNAME=developer
DB_PASSWORD=secret

# Sessions and filesystem
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis, cache and queues
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default

CACHE_STORE=redis
# CACHE_PREFIX=

CACHE_LIMITER_STORE=redis
CONTACT_RATE_LIMIT=5

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
CONTACT_OWNER_EMAIL=owner@example.com

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@developer-landing.test"
MAIL_FROM_NAME="${APP_NAME}"

# AI classification
OPENAI_API_KEY=
OPENAI_MODEL=openrouter/free
OPENAI_URL=https://openrouter.ai/api/v1/chat/completions
OPENAI_CONNECT_TIMEOUT=2
OPENAI_TIMEOUT=20

# Object storage (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend
VITE_APP_NAME="${APP_NAME}"
